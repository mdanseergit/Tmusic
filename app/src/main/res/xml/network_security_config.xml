<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- No first-party endpoint uses HTTP/WS: the built-in Listen Together
         server is wss:// and all lyrics, login and playback endpoints are
         HTTPS. Cleartext is therefore not allowed for any host. -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
